{
  "appId": "com.rayongtrail.live",
  "appName": "Rayong Trail",
  "webDir": "www",
  "server": {
    "androidScheme": "https",
    "url": "https://gps-track-live.pages.dev",
    "cleartext": false
  },
  "plugins": {
    "Geolocation": {
      "permissions": ["location"]
    },
    "FirebaseAuthentication": {
      "skipNativeAuth": false,
      "providers": ["google.com"]
    }
  }
}
